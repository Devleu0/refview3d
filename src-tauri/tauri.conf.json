{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RefView3D",
  "version": "0.1.0",
  "identifier": "com.devleu.refview3d",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RefView3D",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "Korean",
          "Japanese",
          "SimpChinese",
          "TradChinese",
          "Spanish",
          "French",
          "German"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "publisher": "Devleu",
    "copyright": "Copyright (c) 2026 Devleu. MIT License.",
    "category": "GraphicsAndDesign",
    "shortDescription": "3D reference viewer for illustrators",
    "longDescription": "Pose a mannequin, set up lighting and perspective, and export transparent PNG or layered PSD references for drawing.",
    "licenseFile": "../LICENSE"
  }
}
